{
  "expo": {
    "name": "wahid",
    "slug": "Wahid_Mobile_Frontend",
    "scheme": "wahid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/configicons.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wahid.mobile"
    },
    "android": {
      "package": "com.wahid.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/configicons.png"
      }
    },
    "web": {
      "favicon": "./assets/configicons.png"
    },
    "extra": {
      "eas": {
        "projectId": "bf41a0b5-c4db-419f-bf01-a4f6dd92f3cd"
      }
    },
    "owner": "ikasle",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/configicons.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ]
  }
}
