{
  "expo": {
    "name": "wahid",
    "slug": "wahidapp",
    "scheme": "wahid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/configicons.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wahid.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.wahid.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/configicons.png"
      }
    },
    "web": {
      "favicon": "./assets/configicons.png"
    },
    "extra": {
      "eas": {
        "projectId": "bfba7673-ce18-48a0-b9cb-befbbf8ecb65"
      }
    },
    "owner": "ikasletechnologies",
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/configicons.png",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
